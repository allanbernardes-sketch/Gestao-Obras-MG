# URL e chave anônima do Supabase (OBRIGATÓRIAS — sem elas o app não sobe).
#
# Stack local (recomendado para desenvolvimento e testes e2e):
#   1. npx supabase start
#   2. npx supabase status   # copie API URL e anon key para .env.local
#
# Projeto remoto: pegue os valores no dashboard do Supabase (Settings > API).
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="<anon key exibida por: npx supabase status>"
